NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Necesaria para la sincronización con Google Contacts (opcional) y para los avisos push
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Solo necesarios para la sincronización con Google Contacts (opcional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Solo necesarios para los avisos (notificaciones push) de Seguimientos y Tareas (opcional)
# — ver supabase/schema.sql para las instrucciones completas.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
AVISOS_CRON_SECRET=your-random-secret
